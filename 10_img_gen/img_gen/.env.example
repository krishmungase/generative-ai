# Which backend /api/edit-image uses: "cloudflare" (free daily allowance) or "gemini"
IMAGE_PROVIDER=cloudflare

# Cloudflare Workers AI — https://dash.cloudflare.com (Account ID on any zone/Workers page)
# Token needs the "Workers AI" -> Read permission: My Profile -> API Tokens -> Create Token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional override, e.g. @cf/black-forest-labs/flux-2-klein-9b
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Google AI Studio — https://aistudio.google.com/apikey (image models require billing)
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
